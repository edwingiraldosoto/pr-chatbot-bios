# Copia este archivo como .env y completa los valores. .env nunca se sube al repositorio.
# Obligatorios: TELEGRAM_BOT_TOKEN y la API key del proveedor elegido en LLM_PROVIDER.
# Cualquier parámetro de config.yaml se puede sobrescribir aquí con su nombre en
# mayúsculas (lista completa al final). Los cambios se aplican al reiniciar el bot.

# ----------------------------------------------------------------------------------------
# Secretos
# ----------------------------------------------------------------------------------------

# Token del bot, entregado por @BotFather al crear el bot con /newbot.
TELEGRAM_BOT_TOKEN=123456789:AAExampleTokenReplaceMe

# Código del enlace de invitación (opcional). Quien abra
# https://t.me/<tu_bot>?start=<este código> queda autorizado sin dar su ID antes.
# 12 a 64 caracteres: letras sin tilde, números, _ y -. Cambiarlo retira el acceso a
# todos los invitados. Los administradores ven el enlace con /invitacion.
# INVITE_CODE=bios-evaluacion-cambia-esto

# API keys de cada proveedor de LLM. Solo es obligatoria la del proveedor activo
# (LLM_PROVIDER); puedes dejar las tres y cambiar de proveedor sin tocar este bloque.
# Anthropic: https://console.anthropic.com/ (Settings > API keys).
LLM_ANTHROPIC_API_KEY=replace-with-your-anthropic-key

# OpenAI (o la API compatible definida en LLM_OPENAI_BASE_URL): https://platform.openai.com/api-keys
# LLM_OPENAI_API_KEY=

# Google Gemini: https://aistudio.google.com/apikey
# LLM_GEMINI_API_KEY=

# Genérica del enunciado: API key del proveedor activo cuando no tiene la suya arriba.
# LLM_API_KEY=

# ----------------------------------------------------------------------------------------
# Acceso (dependen del despliegue)
# ----------------------------------------------------------------------------------------

# IDs numéricos de Telegram autorizados, separados por comas. Para conocer tu ID escríbele
# a @userinfobot, o escríbele al bot: si no tienes acceso, te muestra tu ID.
ALLOWED_USER_IDS=111111111,222222222

# IDs de administradores (pueden usar /reindex). Tienen acceso aunque no estén arriba.
ADMIN_USER_IDS=111111111

# ----------------------------------------------------------------------------------------
# Modelo de lenguaje (opcional: sobrescriben config.yaml)
# ----------------------------------------------------------------------------------------

# Proveedor activo: anthropic | openai | gemini. Cambiarlo es lo único necesario para
# pasar de un proveedor a otro (con su API key arriba). Verifica con:
#   python -m mesa_ayuda.llm.check
# LLM_PROVIDER=anthropic

# Máximo de tokens por respuesta.
# LLM_MAX_TOKENS=600

# Máximo de tokens al reformular una pregunta de seguimiento.
# LLM_REWRITE_MAX_TOKENS=100

# Límite del único reintento cuando una respuesta se corta por LLM_MAX_TOKENS
# (0 = sin reintento; si no es 0, mayor que LLM_MAX_TOKENS).
# LLM_TRUNCATED_RETRY_MAX_TOKENS=1200

# Segundos máximos de espera por respuesta, reintentos incluidos.
# LLM_TIMEOUT_SECONDS=30

# Reintentos ante errores transitorios del proveedor.
# LLM_MAX_RETRIES=2

# Anthropic: modelo y esfuerzo de razonamiento (low | medium | high | xhigh | max | none).
# LLM_ANTHROPIC_MODEL=claude-haiku-5-5

# Esfuerzo de razonamiento de Anthropic; "none" para modelos que no lo aceptan.
# LLM_ANTHROPIC_EFFORT=low
# Razonamiento del modelo: disabled | adaptive ("none" = no se envía).
# LLM_ANTHROPIC_THINKING=disabled

# OpenAI: ID del modelo (o el nombre que use la API compatible).
# LLM_OPENAI_MODEL=gpt-5-mini

# OpenAI: URL de una API compatible (Groq, Ollama, vLLM...). Sin definir = OpenAI.
# LLM_OPENAI_BASE_URL=http://localhost:11434/v1

# OpenAI: temperatura (0-2); "none" = no se envía (los GPT-5 solo aceptan la de fábrica).
# LLM_OPENAI_TEMPERATURE=none

# OpenAI: esfuerzo de razonamiento (minimal | low | medium | high | none).
# LLM_OPENAI_REASONING_EFFORT=low

# OpenAI: nombre del límite de salida (auto | max_tokens | max_completion_tokens).
# LLM_OPENAI_TOKEN_PARAM=auto

# Gemini: ID del modelo.
# LLM_GEMINI_MODEL=gemini-2.5-flash

# Gemini: temperatura (0-2); "none" = la de fábrica.
# LLM_GEMINI_TEMPERATURE=0.1

# Genérica del enunciado: reemplaza el modelo del proveedor activo, sea cual sea.
# Si la usas, revísala al cambiar de proveedor.
# LLM_MODEL=claude-haiku-5-5

# Genérica del enunciado: reemplaza la URL de openai.
# LLM_BASE_URL=

# Genérica del enunciado: reemplaza la temperatura del proveedor activo (0-2).
# LLM_TEMPERATURE=0.1

# ----------------------------------------------------------------------------------------
# Embeddings, documentos y recuperación (opcional: sobrescriben config.yaml)
# ----------------------------------------------------------------------------------------

# Proveedor de embeddings: local (sin API key).
# EMBEDDING_PROVIDER=local

# Modelo de embeddings; si cambia, el índice se reconstruye.
# EMBEDDING_MODEL=intfloat/multilingual-e5-small

# Carpeta de documentos.
# KNOWLEDGE_BASE_PATH=./knowledge_base

# Tamaño de fragmento en caracteres.
# CHUNK_SIZE=800

# Solapamiento entre fragmentos en caracteres (menor que CHUNK_SIZE).
# CHUNK_OVERLAP=150

# Fragmentos recuperados por pregunta.
# RETRIEVAL_TOP_K=5

# Similitud mínima (0-1) para considerar relevante un fragmento.
# SIMILARITY_THRESHOLD=0.80

# Archivo con el prompt de sistema.
# SYSTEM_PROMPT_PATH=./prompts/system_prompt.md

# Archivo con el prompt de reformulación de preguntas de seguimiento.
# REWRITE_PROMPT_PATH=./prompts/rewrite_prompt.md

# ----------------------------------------------------------------------------------------
# Conversación, logs y operación (opcional: sobrescriben config.yaml)
# ----------------------------------------------------------------------------------------

# Mensajes de historial conservados por usuario (0 = sin historial).
# HISTORY_LENGTH=6

# Mensajes máximos por usuario por minuto.
# RATE_LIMIT_PER_MINUTE=10

# Segundos en los que el mismo texto repetido se responde una sola vez (0 = desactivado).
# DUPLICATE_WINDOW_SECONDS=5

# Preguntas al modelo por usuario por día (los administradores no tienen tope).
# DAILY_QUESTIONS_PER_USER=50

# Preguntas al modelo de todos los usuarios por día.
# DAILY_QUESTIONS_TOTAL=300

# Largo máximo de una pregunta, en caracteres.
# MAX_QUESTION_CHARS=1000

# Nivel de detalle de los logs: DEBUG | INFO | WARNING | ERROR.
# LOG_LEVEL=INFO

# Registrar el texto de las preguntas en los logs (true/false).
# LOG_QUESTIONS=false

# Carpeta de datos generados (índice, manifest, SQLite).
# DATA_DIR=./data

# Hora diaria de reindexación HH:MM (vacío = desactivada).
# REINDEX_SCHEDULE_TIME=03:00

# Zona horaria de la reindexación programada.
# REINDEX_TIMEZONE=America/Bogota

# Avisar a los administradores tras la reindexación programada si hubo cambios (true/false).
# REINDEX_NOTIFY_ADMINS=true

# Revisión de instrucciones sospechosas en documentos: off | warn | quarantine.
# INJECTION_CHECK=warn

# Botón para descargar el documento citado (true/false).
# SOURCE_DOWNLOAD=false
